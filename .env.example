DATABASE_URL="your-postgres-connection-string"
AUTH_SECRET="generate-a-random-32-byte-secret"
NEXTAUTH_URL="http://localhost:3000"
# Optional: set to enable live Claude-powered AI Coach responses grounded in real Passport data.
# Without it, the Coach still works using the deterministic, explainable recommendation engine.
ANTHROPIC_API_KEY=""
AUTH_TRUST_HOST=true

# Evidence file storage (S3-compatible object storage). Required for Passport evidence file
# uploads — see SECURITY.md for the region/encryption-at-rest requirements these values must
# satisfy. Works against real AWS S3, or any S3-compatible provider (Cloudflare R2, Backblaze
# B2, MinIO, DigitalOcean Spaces) via S3_ENDPOINT.
S3_BUCKET=""
S3_REGION="ca-central-1"
# Leave unset for real AWS S3. Set for a non-AWS S3-compatible provider.
S3_ENDPOINT=""
# Set to "true" for MinIO / most self-hosted S3-compatible providers.
S3_FORCE_PATH_STYLE="false"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
